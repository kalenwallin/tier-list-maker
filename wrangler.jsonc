{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tier-list-maker",
  "main": "src/server.ts",
  // Runtime variables are managed in the Cloudflare dashboard. Preserve them
  // when Wrangler deploys a new Worker version.
  "keep_vars": true,
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "tierlistmaker.win",
      "custom_domain": true
    },
    // Lets src/server.ts redirect `www` to the apex. A route only runs while
    // its hostname has a proxied DNS record, so keep the `www` record even
    // though its origin is never reached.
    {
      "pattern": "www.tierlistmaker.win/*",
      "zone_name": "tierlistmaker.win"
    }
  ],
  // Item images people upload or copy from links. src/routes/api/images.ts
  // stores them and src/routes/images/$key.ts serves them. Create the bucket
  // once with `bunx wrangler r2 bucket create tier-list-maker-item-images`.
  "r2_buckets": [
    {
      "binding": "ITEM_IMAGES",
      "bucket_name": "tier-list-maker-item-images"
    }
  ],
  // Caps how fast one account can add images. Limits are counted per
  // Cloudflare location, so treat them as approximate.
  "ratelimits": [
    {
      "name": "ITEM_IMAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
