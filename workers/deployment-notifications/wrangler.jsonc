{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tier-list-maker-deployment-notifications",
  "account_id": "237d967ddf37a3b1587e673236320925",
  "main": "index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCOUNT_ID": "237d967ddf37a3b1587e673236320925",
    "WORKER_NAME": "tier-list-maker",
    "BRANCH": "main"
  },
  "queues": {
    "consumers": [
      {
        "queue": "tier-list-maker-deployments",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "tier-list-maker-deployments-failed"
      }
    ]
  },
  "observability": { "enabled": true }
}
